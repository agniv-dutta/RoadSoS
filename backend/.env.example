# No mandatory third-party APIs are required for local development.

DATABASE_URL=sqlite+aiosqlite:///./roadsos.db
# For MySQL: DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/roadsos

# Optional: live nearby place sync for the admin endpoint.
GEOAPIFY_PLACES_API_KEY=
GEOAPIFY_REVERSE_GEOCODING_API_KEY=
GEOAPIFY_ROUTING_API_KEY=

# Optional: outbound SMS delivery via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional, but use a different value if you expose admin routes publicly.
ADMIN_SECRET_KEY=roadsos_admin_2026

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
